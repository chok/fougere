datasource db {
    provider = 'sqlite'
    url      = 'file:./dev.db'
}

model Post {
    id          String    @id @default(cuid())
    title       String    @length(1, 200)
    body        String
    excerpt     String?
    createdAt   DateTime  @default(now())
    publishedAt DateTime?
}

mutation procedure publishPost(id: String) : Post
