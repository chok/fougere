{
  // A Frond is autonomous TypeScript domain code — it typechecks on its own,
  // against the workspace config, without Nuxt or `.nuxt/tsconfig.json`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // A frond names its neighbours, it does not walk to them. The alias is what the
    // Nuxt module registers at runtime (`@frond/<name>` → the frond directory); this
    // is the same statement for the compiler.
    "paths": {
      "@frond/blog/*": ["./blog/*"],
      "@frond/user/*": ["./user/*"]
    }
  },
  "include": ["."]
}
