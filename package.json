{
  "name": "fougere",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint packages site demos",
    "knip": "knip",
    "coverage": "pnpm -r --filter './packages/**' exec vitest run --passWithNoTests --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.include=src/**",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "build:apps": "pnpm -r --filter \"./demos/**\" --filter ./site build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@swc/core": "^1.15.21",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "4.1.0",
    "knip": "^6.32.1",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.0"
  }
}
