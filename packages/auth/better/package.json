{
  "name": "@fougere/auth-better",
  "version": "0.4.0-alpha.0",
  "description": "Fougere's auth — a translation layer onto better-auth.",
  "keywords": [
    "fougere",
    "better-auth",
    "auth",
    "authentication",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/auth/better"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/core": "workspace:*",
    "@fougere/schema": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.6.11"
  },
  "devDependencies": {
    "@fougere/adapter-sql": "workspace:*",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
