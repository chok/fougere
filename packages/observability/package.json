{
  "name": "@fougere/observability",
  "version": "0.12.1-alpha.0",
  "description": "Optional observability for Fougere: one span per operation, W3C Trace Context across any transport.",
  "keywords": [
    "fougere",
    "typescript",
    "tracing",
    "observability",
    "opentelemetry",
    "trace-context"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/observability"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@fougere/core": "workspace:^",
    "@fougere/adapter-sql": "workspace:^"
  },
  "devDependencies": {
    "@fougere/adapter-sql": "workspace:*",
    "@fougere/compiler": "workspace:*",
    "@fougere/container": "workspace:*",
    "@fougere/core": "workspace:*",
    "@fougere/schema": "workspace:*",
    "@fougere/transport-http": "workspace:*",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#trace-context": {
      "types": "./src/context/als.ts",
      "workerd": "./dist/context/none.js",
      "default": "./dist/context/als.js"
    }
  },
  "peerDependenciesMeta": {
    "@fougere/adapter-sql": {
      "optional": true
    }
  }
}
