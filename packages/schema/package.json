{
  "name": "@fougere/schema",
  "version": "0.0.1",
  "description": "L'entité et ses 4 axes — shape, role, lifecycle, boundary. Zéro dépendance à un moteur.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/schema"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
