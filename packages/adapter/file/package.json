{
  "name": "@fougere/adapter-file",
  "version": "0.5.0-alpha.1",
  "description": "Rows as files — one JSON per row, in a directory per entity.",
  "keywords": [
    "fougere",
    "typescript",
    "storage",
    "filesystem",
    "json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/adapter/file"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/core": "workspace:*",
    "@fougere/schema": "workspace:*",
    "@fougere/adapter-memory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
