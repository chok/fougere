{
  "name": "@fougere/adapter-graphql",
  "version": "0.3.0-alpha.0",
  "description": "Entity \u2192 GraphQL types, inputs and CRUD, through Pothos.",
  "keywords": [
    "fougere",
    "typescript",
    "graphql",
    "pothos",
    "schema-first",
    "codegen"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/adapter/graphql"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pothos": {
      "types": "./dist/pothos-entry.d.ts",
      "import": "./dist/pothos-entry.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/schema": "workspace:*",
    "@fougere/http": "workspace:*"
  },
  "peerDependencies": {
    "@pothos/core": ">=4.0.0",
    "graphql": ">=16.0.0"
  },
  "devDependencies": {
    "@pothos/core": "^4.12.0",
    "graphql": "^16.13.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
