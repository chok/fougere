{
  "name": "@fougere/adapter-sql",
  "version": "0.2.0-alpha.2",
  "description": "Entity → SQL tables through Kysely (SQLite, PostgreSQL, MySQL, SQL Server).",
  "keywords": [
    "fougere",
    "typescript",
    "kysely",
    "sql",
    "sqlite",
    "postgresql",
    "mysql",
    "orm",
    "ddl"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/adapter/sql"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/schema": "workspace:*",
    "better-sqlite3": "^13.0.3"
  },
  "peerDependencies": {
    "kysely": ">=0.28.17"
  },
  "devDependencies": {
    "@fougere/core": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "kysely": "^0.28.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
