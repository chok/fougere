{
  "name": "@fougere/adapter-env",
  "version": "0.27.0-alpha.0",
  "description": "The process environment as a source — MEILI_URL read as Meili's url, judged at boot.",
  "keywords": [
    "fougere",
    "typescript",
    "config",
    "environment",
    "env"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/adapter/env"
  },
  "type": "module",
  "sideEffects": ["./dist/index.js"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/core": "workspace:*",
    "@fougere/schema": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@fougere/container": "workspace:*",
    "@fougere/defaults": "workspace:*"
  }
}
