{
  "name": "@fougere/adapter-memory",
  "version": "0.5.0-alpha.1",
  "description": "Rows in a Map — the source a first run meets, and the one that ships no driver.",
  "keywords": ["fougere", "typescript", "storage", "in-memory", "testing"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/adapter/memory"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/core": "workspace:*",
    "@fougere/schema": "workspace:*"
  },
  "publishConfig": { "access": "public" }
}
