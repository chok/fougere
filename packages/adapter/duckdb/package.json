{
  "name": "@fougere/adapter-duckdb",
  "version": "0.6.0-alpha.0",
  "description": "Read across an app's sources \u2014 one SQL query over what DuckDB can attach.",
  "keywords": [
    "fougere",
    "typescript",
    "duckdb",
    "federation",
    "analytics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/adapter/duckdb"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/schema": "workspace:*",
    "@fougere/adapter-sql": "workspace:*"
  },
  "peerDependencies": {
    "@duckdb/node-api": ">=1.4.0-0"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "better-sqlite3": "^13.0.3",
    "@types/better-sqlite3": "^7.6.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
