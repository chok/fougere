{
  "name": "@fougere/defaults",
  "version": "0.2.0-alpha.1",
  "description": "The conventional boot of a Fougere app \u2014 the one place storage is wired.",
  "keywords": [
    "fougere",
    "typescript",
    "framework",
    "bootstrap",
    "sqlite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/defaults"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fougere/core": "workspace:*",
    "@fougere/adapter-sql": "workspace:*",
    "@fougere/transport-http": "workspace:*",
    "@fougere/container": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@fougere/schema": "workspace:*",
    "kysely": "^0.28.17",
    "better-sqlite3": "^13.0.3",
    "@types/better-sqlite3": "^7.6.13"
  }
}
