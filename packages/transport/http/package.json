{
  "name": "@fougere/transport-http",
  "version": "0.0.1",
  "description": "Le contrat d'appel sur le fil, en JSON-RPC 2.0 (serveur + client).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/transport/http"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../../scripts/clean-dist.mjs && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/core": "workspace:*"
  },
  "devDependencies": {
    "@fougere/container-fougere": "workspace:*",
    "@fougere/schema": "workspace:*",
    "jiti": "^2.6.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
