{
  "name": "@fougere/transport-http",
  "version": "0.30.0-alpha.5",
  "description": "The call contract on the wire, in JSON-RPC 2.0 (server + client).",
  "keywords": [
    "fougere",
    "typescript",
    "json-rpc",
    "rpc",
    "http",
    "microservices"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/transport/http"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/transports.js"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./receive": {
      "types": "./dist/receive.d.ts",
      "import": "./dist/receive.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "srvx": "^1.0.5"
  },
  "devDependencies": {
    "@fougere/compiler": "workspace:*",
    "@fougere/container": "workspace:*",
    "@fougere/core": "workspace:*",
    "@fougere/schema": "workspace:*",
    "jiti": "^2.6.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@fougere/core": "workspace:*"
  }
}
