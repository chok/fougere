{
  "name": "@fougere/core",
  "version": "0.2.0-alpha.2",
  "description": "The core \u2014 scan, call contract, fa\u00e7ades, remote stand-ins.",
  "keywords": [
    "fougere",
    "typescript",
    "framework",
    "dependency-injection",
    "rpc",
    "microservices",
    "monorepo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    }
  },
  "imports": {
    "#ambient": {
      "types": "./src/boot/ambient.als.ts",
      "workerd": "./dist/boot/ambient.queue.js",
      "default": "./dist/boot/ambient.als.js"
    },
    "#crypto": {
      "types": "./src/crypto/node.ts",
      "workerd": "./dist/crypto/webcrypto.js",
      "default": "./dist/crypto/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc6",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "typecheck": "tsc6 --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/container": "workspace:*",
    "@fougere/schema": "workspace:*",
    "@typescript/typescript6": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
