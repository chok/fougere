{
  "include": [
    "${configDir}/fronds",
    "${configDir}/fougere.config.ts",
    "${configDir}/.fougere/names.generated.d.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@fronds/facade": [
        "${configDir}/.fougere/facade.generated.ts",
        "${configDir}/../.fougere/facade.generated.ts"
      ],
      "@fronds/*": [
        "${configDir}/fronds/*",
        "${configDir}/*",
        "${configDir}/remotes/*",
        "${configDir}/../remotes/*",
        "${configDir}/remotes/*/index.ts",
        "${configDir}/../remotes/*/index.ts"
      ]
    }
  }
}
