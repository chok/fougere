{
  "name": "@fougere/state-session",
  "version": "0.26.0-alpha.0",
  "description": "A caller's state kept in a session — what `state: { cart: { session: {} } }` names: one cookie holds a reference, the values a row in a source.",
  "keywords": [
    "fougere",
    "typescript",
    "state",
    "session"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/state/session"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/core": "workspace:*",
    "@fougere/state-cookie": "workspace:*",
    "@fougere/schema": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
