{
  "name": "@fougere/auth-better",
  "version": "0.0.1",
  "description": "Auth Fougere — couche de traduction vers better-auth.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/auth-better"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/core": "workspace:*",
    "@fougere/schema": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "better-auth": "^1.6.11"
  },
  "devDependencies": {
    "@fougere/schema-sql": "workspace:*",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
