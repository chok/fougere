{
  "name": "@fougere/http",
  "version": "0.27.0-alpha.0",
  "description": "The words every HTTP door speaks — a method, an answer, the headers a state travels in.",
  "keywords": [
    "fougere",
    "typescript",
    "http"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/http"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
