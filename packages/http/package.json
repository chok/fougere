{
  "name": "@fougere/http",
  "version": "0.0.1",
  "description": "Routeur HTTP et middlewares.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/http"
  },
  "type": "module",
  "main": "dist/index.js",
