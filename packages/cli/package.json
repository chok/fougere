{
  "name": "@fougere/cli",
  "version": "0.12.5-alpha.0",
  "description": "The Fougere CLI \u2014 compose a workspace, serve a frond, call an operation.",
  "keywords": [
    "fougere",
    "cli",
    "typescript",
    "scaffold",
    "codegen"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "fougere": "dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./bin": "./dist/src/bin.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "rm -rf dist && node scripts/scan.ts && tsc && chmod +x dist/src/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json && tsc -p tsconfig.templates.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "@fougere/compiler": "workspace:*",
    "@fougere/container": "workspace:*",
    "@fougere/core": "workspace:*",
    "@fougere/defaults": "workspace:*",
    "@fougere/schema": "workspace:*",
    "@fougere/testing": "workspace:*",
    "@fougere/transport-http": "workspace:*",
    "citty": "^0.2.1",
    "consola": "^3.4.2",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "safe-regex": "^2.1.1"
  },
  "devDependencies": {
    "@fougere/admin": "workspace:*",
    "@fougere/next": "workspace:*",
    "@fougere/nuxt": "workspace:*",
    "@fougere/oclif": "workspace:*",
    "@fougere/react": "workspace:*",
    "@fougere/svelte": "workspace:*",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@fougere/adapter-sql": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@fougere/adapter-sql": {
      "optional": true
    }
  }
}
