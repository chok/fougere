{
  "name": "@fougere/cli",
  "version": "0.3.0-alpha.0",
  "description": "The Fougere CLI \u2014 compose a workspace, serve a frond, call an operation.",
  "keywords": [
    "fougere",
    "cli",
    "typescript",
    "scaffold",
    "codegen"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fougere": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": "./dist/bin.js"
  },
  "files": [
    "dist",
    "app",
    "fronds",
    "templates",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/bin.js && node dist/bin.js build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json && tsc -p tsconfig.templates.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "@fougere/adapter-sql": "workspace:*",
    "@fougere/container": "workspace:*",
    "@fougere/core": "workspace:*",
    "@fougere/defaults": "workspace:*",
    "@fougere/schema": "workspace:*",
    "@fougere/transport-http": "workspace:*",
    "citty": "^0.2.1",
    "consola": "^3.4.2",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
