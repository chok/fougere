{
  "name": "@fougere/cli",
  "version": "0.0.1",
  "description": "La CLI Fougere — composer un workspace, servir un frond, appeler une op.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fougere": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "app",
    "fronds",
    "templates"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json && tsc -p tsconfig.templates.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/cli-ui": "workspace:*",
    "@fougere/container-fougere": "workspace:*",
    "@fougere/core": "workspace:*",
    "@fougere/runtime": "workspace:*",
    "@fougere/schema": "workspace:*",
    "@fougere/transport-http": "workspace:*",
    "citty": "^0.2.1",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
