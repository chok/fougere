{
  // The frond and fougere.config.ts are autonomous TypeScript — they typecheck on their own, against this file.
  "extends": "@fougere/core/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["fronds", "fougere.config.ts"]
}
