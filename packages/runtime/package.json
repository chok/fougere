{
  "name": "@fougere/runtime",
  "version": "0.2.0-alpha.1",
  "description": "The conventional boot of a Fougere app — the one place storage is wired.",
  "keywords": [
    "fougere",
    "typescript",
    "framework",
    "bootstrap",
    "sqlite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/core": "workspace:*",
    "@fougere/schema-sql": "workspace:*",
    "@fougere/transport-http": "workspace:*",
    "@fougere/container": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
