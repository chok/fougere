{
  "name": "@fougere/schema-rest",
  "version": "0.0.1",
  "description": "Entité → routes REST.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/schema-rest"
  },
  "type": "module",
