{
  "name": "@fougere/schema-graphql",
  "version": "0.0.1",
  "description": "Entit\u00e9 \u2192 types, inputs et CRUD GraphQL via Pothos.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/schema-graphql"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pothos": {
      "types": "./dist/pothos-entry.d.ts",
      "import": "./dist/pothos-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/schema": "workspace:*",
    "@fougere/http": "workspace:*"
  },
  "peerDependencies": {
    "@pothos/core": ">=4.0.0",
    "graphql": ">=16.0.0"
  },
  "devDependencies": {
    "@pothos/core": "^4.12.0",
    "graphql": "^16.13.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
