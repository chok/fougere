{
  "name": "@fougere/schema-sql",
  "version": "0.0.1",
  "description": "Entité → tables SQL via Kysely (SQLite, PostgreSQL, MySQL, SQL Server).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/schema-sql"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/schema": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-sqlite3": "^12.8.0"
  },
  "peerDependencies": {
    "kysely": ">=0.28.17"
  },
  "devDependencies": {
    "@fougere/core": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "kysely": "^0.28.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
