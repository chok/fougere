{
  "name": "@fougere/react",
  "version": "0.3.0-alpha.0",
  "description": "Fougere's four primitives as React hooks \u2014 host-independent.",
  "keywords": [
    "fougere",
    "react",
    "hooks",
    "typescript",
    "fullstack",
    "rpc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/app/react"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/app": "workspace:*",
    "@fougere/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "react": "19.2.8",
    "vitest": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.0.0",
    "react-dom": "19.2.8",
    "@fougere/schema": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
