{
  "create": [
    "create-nuxt@3",
    "{dir}",
    "--template",
    "minimal",
    "--packageManager",
    "{pm}",
    "--no-install",
    "--gitInit",
    "false",
    "--force"
  ],
  "dependencies": {
    "@fougere/core": "latest",
    "@fougere/schema": "latest",
    "@fougere/defaults": "latest",
    "@fougere/container": "latest",
    "@fougere/log": "latest",
    "@fougere/nuxt": "latest"
  },
  "devDependencies": {
    "@fougere/compiler": "latest"
  },
  "wire": {
    "kind": "nuxtModule",
    "file": "nuxt.config.ts",
    "module": "@fougere/nuxt"
  }
}
