{
  "create": [
    "create-nuxt@3",
    "{dir}",
    "--template",
    "minimal",
    "--packageManager",
    "pnpm",
    "--no-install",
    "--gitInit",
    "false",
    "--force"
  ],
  "dependencies": {
    "@fougere/core": "latest",
    "@fougere/schema": "latest",
    "@fougere/defaults": "latest",
    "@fougere/container": "latest",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.28.17",
    "@fougere/nuxt": "latest"
  },
  "wire": {
    "kind": "nuxtModule",
    "file": "nuxt.config.ts",
    "module": "@fougere/nuxt",
    "configKey": "fougere",
    "options": {
      "root": "../.."
    }
  }
}
