{
  "name": "@fougere/nuxt",
  "version": "0.3.0-alpha.0",
  "description": "The Nuxt module: Fougere's client primitives and server surface.",
  "keywords": [
    "fougere",
    "nuxt",
    "nuxt-module",
    "vue",
    "typescript",
    "fullstack",
    "rpc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/app/nuxt"
  },
  "type": "module",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    }
  },
  "files": [
    "dist",
    "src/runtime"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/app": "workspace:*",
    "@fougere/core": "workspace:*",
    "@fougere/defaults": "workspace:*",
    "@nuxt/kit": "^4.5.1",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.5.1",
    "h3": "^1.15.11",
    "nitropack": "^2.13.2",
    "nuxt": "^4.5.1",
    "vue": "^3.5.40",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "h3": "^1.15.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
