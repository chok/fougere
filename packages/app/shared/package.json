{
  "name": "@fougere/app",
  "version": "0.2.0-alpha.1",
  "description": "The host-independent half of a Fougere app: boot, call envelope, REST table, form contract.",
  "keywords": [
    "fougere",
    "typescript",
    "fullstack",
    "rpc",
    "adapter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/app/shared"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/core": "workspace:*",
    "@fougere/defaults": "workspace:*",
    "@fougere/schema": "workspace:*",
    "@fougere/adapter-rest": "workspace:*",
    "@fougere/transport-http": "workspace:*",
    "jiti": "^2.6.1",
    "@fougere/http": "workspace:*",
    "@fougere/container": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "@fougere/adapter-graphql": "workspace:*",
    "@pothos/core": "^4.12.0",
    "graphql": "^16.13.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@fougere/adapter-graphql": "^0.2.0-alpha.0",
    "@pothos/core": "^4.0.0",
    "graphql": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "@fougere/adapter-graphql": {
      "optional": true
    },
    "@pothos/core": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  }
}
