{
  "name": "@fougere/next",
  "version": "0.26.0-alpha.0",
  "description": "The Next.js adapter: mounting, and the one import that is genuinely Next.",
  "keywords": [
    "fougere",
    "next",
    "nextjs",
    "react",
    "typescript",
    "fullstack",
    "rpc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/app/next"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "import": "./dist/route.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "src",
    "template"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/app": "workspace:*",
    "@fougere/core": "workspace:*",
    "jiti": "^2.7.0",
    "terser-webpack-plugin": "^5.3.14"
  },
  "peerDependenciesMeta": {
    "@fougere/compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fougere/compiler": "workspace:*",
    "next": "^15.5.26",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@fougere/compiler": "workspace:^",
    "next": "^15.0.0 || ^16.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
