{
  "create": [
    "create-next-app@16",
    "{dir}",
    "--ts",
    "--app",
    "--skip-install",
    "--disable-git",
    "--use-pnpm",
    "--yes",
    "--no-tailwind",
    "--no-eslint",
    "--no-src-dir",
    "--import-alias",
    "@/*",
    "--empty"
  ],
  "dependencies": {
    "@fougere/core": "latest",
    "@fougere/schema": "latest",
    "@fougere/defaults": "latest",
    "@fougere/container": "latest",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.28.17",
    "@fougere/next": "latest",
    "@fougere/react": "latest"
  },
  "wire": {
    "kind": "wrapExport",
    "file": "next.config.ts",
    "from": "@fougere/next/config",
    "imported": "withFougere",
    "options": {
      "root": "../.."
    }
  },
  "tsconfig": "tsconfig.json"
}
