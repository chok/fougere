    "@fougere/transport-http": "workspace:*",
    "@nuxt/kit": "^4.4.2",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "nitropack": "^2.13.2",
    "nuxt": "^4.4.2",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
