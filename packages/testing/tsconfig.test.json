{
  // The build emits `dist` from `src` alone; the tests are not shipped but still have
  // to compile — this package reads the axes, and a signature that drifts there is
  // only caught by a compiler.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "tests"]
}
