{
  "name": "@fougere/container-fougere",
  "version": "0.2.0-alpha.0",
  "description": "A DI container that resolves by type, wired from the AST scan.",
  "keywords": [
    "fougere",
    "typescript",
    "dependency-injection",
    "ioc",
    "container"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/container-fougere"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fougere/container": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
