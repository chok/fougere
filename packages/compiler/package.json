{
  "name": "@fougere/compiler",
  "version": "0.8.3-alpha.0",
  "description": "The scan: Fougere reading a project's source to produce the descriptors core boots from. Needs a filesystem and a TypeScript program.",
  "keywords": [
    "fougere",
    "typescript",
    "scan",
    "ast",
    "codegen"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chok/fougere.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm --filter @fougere/core build && rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@typescript/typescript6": "^6.0.2"
  },
  "peerDependencies": {
    "@fougere/core": "workspace:^",
    "@fougere/container": "workspace:^"
  },
  "devDependencies": {
    "@fougere/core": "workspace:*",
    "@fougere/schema": "workspace:*",
    "vitest": "^4.1.0",
    "@fougere/container": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
