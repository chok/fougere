{
  "extends": "@fougere/core/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["server.ts", "fougere.config.ts", "fronds", ".fougere/names.generated.d.ts"],
  "exclude": ["node_modules"]
}
