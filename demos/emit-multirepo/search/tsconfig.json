{
  // `search` accepts a fact whose SHAPE it does not hold: `pnpm sync` fetches it from the
  // blog's identity card into `remotes/`, versioned so a fresh clone compiles with no peer running.
  "extends": ["@fougere/core/tsconfig", "../../../tsconfig.base.json"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["."],
  "exclude": ["**/dist", "node_modules"]
}
