{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    // A frond names its neighbours by the name they publish, never by a path through the
    // tree — the same statement `fronds/tsconfig.json` makes for the compiler, repeated here
    // because this is the file the runner reads.
    "paths": {
      "@fronds/people/*": ["./fronds/people/*"],
      "@fronds/blog/*": ["./fronds/blog/*"],
      "@fronds/discussion/*": ["./fronds/discussion/*"]
    }
  },
  "include": ["src", "fronds"]
}
