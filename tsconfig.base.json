{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node20",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  }
}
